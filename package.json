{
  "name": "armenian-mastery-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "test:e2e": "node scripts/mobile-browser-acceptance.mjs",
    "test:e2e:mobile": "node scripts/mobile-browser-acceptance.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:core-parity": "node scripts/check-core-parity.mjs",
    "check:favicon": "node scripts/check-favicon-coverage.mjs",
    "check:ui-font": "node scripts/check-forest-font.mjs",
    "build:teacher": "node scripts/build-teacher-entry.mjs",
    "check:teacher-bundle": "node scripts/build-teacher-entry.mjs --check",
    "build:browser-sdk": "node scripts/build-browser-sdk.mjs",
    "check:browser-sdk": "node scripts/build-browser-sdk.mjs --check",
    "build:web-assets": "node scripts/build-web-assets.mjs --update",
    "check:web-assets": "node scripts/build-web-assets.mjs --check && node scripts/check-web-archive.mjs",
    "build:web": "node scripts/build-web-assets.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "^1.65.0",
    "@supabase/functions-js": "2.119.0",
    "@supabase/supabase-js": "2.119.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.2"
  }
}
