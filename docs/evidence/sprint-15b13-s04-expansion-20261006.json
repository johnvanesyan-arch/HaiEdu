        "referenceMetadata": {
          "textbookSha256": "d8404d572f145d4afe924d0b8af900b3d9ed085a37893594667ab07a2ec12904",
          "textbookLocator": "Ֆիզիկա 7 (2023), Գլուխ II, §8-9, տպագիր էջեր 28-30, նկարներ 28-29",
          "programmeOutcomeLocator": "7-րդ դասարան / Թեմա 2 / Վերջնարդյունքներ / Պարտադիր 1(2)"
        },
        "authoringProfileVersion": "haiedu-evidence-blueprint-v1"
      },
      "title_hy": "Ինչպե՞ս կապել պատկերի, մասնիկի և ամբողջ մարմնի չափերը",
      "hint_1_hy": "Պարզի՛ր՝ չափված երկարությունն ի՞նչ է ներառում, և պատկերի չափն արդյո՞ք նույնն է, ինչ իրական մարմնի չափը։",
      "hint_2_hy": "Ստուգի՛ր փոփոխության ուղղությունը. ավելացած բացերը մեծացնո՞ւմ են շարքի երկարությունը, իսկ խոշորացված պատկերից իրական չափին անցնելիս չափը մեծանո՞ւմ է, թե՞ փոքրանում։",
      "created_at": "2026-10-06T20:22:05.725248+00:00",
      "updated_at": "2026-10-06T20:22:05.725248+00:00",
      "strategy_hy": "Նախ տարբերակի՛ր՝ տրվածը ամբողջ շարքի՞ երկարությունն է, խոշորացված պատկերի՞ չափը, թե՞ մասնիկների թիվը։ Գնդիկների շարքով տրամագիծ որոշելիս նույնաչափ գնդիկները պետք է հպվեն իրար. բացերով չափված երկարությունը պարունակում է նաև ավելորդ տարածություն։ Խոշորացված պատկերից իրական չափը գտնելու համար պատկերի տրված չափը բաժանի՛ր խոշորացման գործակցին։ Փոքր մարմնում կարող են լինել շատ մասնիկներ, եթե յուրաքանչյուր մասնիկն ամբողջ մարմնի համեմատ չափազանց փոքր է. փոքր չափը զրոյական չափ չէ։",
      "guide_version": 1,
      "item_template_id": "9a3694be-2de9-4cb2-8d31-03e1bf06551f",
      "worked_example_hy": "Օրինակ՝ 50 անգամ խոշորացված պատկերի վրա մանր մարմնի երկարությունը 15 մմ է։ Նրա իրական երկարությունը 15 մմ ÷ 50 = 0,3 մմ է։ Նույն միավորը պահպանվում է, իսկ արդյունքը փոքր է պատկերի չափից։ Շարքով չափման այլ խնդրում էլ նախ ստուգում ենք, որ ընդհանուր երկարության մեջ ավելորդ բացեր չկան։",
      "trigger_error_code": null,
      "allowed_parameter_keys": []
    },
