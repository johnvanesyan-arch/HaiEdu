        "content_snapshot": {
          "status": "draft",
          "hint1Hy": "Ի՞նչն է փոխվել փորձի ընթացքում, և արդյո՞ք նյութ է մտել կամ դուրս եկել համակարգից։",
          "hint2Hy": "Տարբերակիր նյութի զբաղեցրած ծավալը մասնիկների քանակից ու չափերից։ Մասնիկների միջև տարածությունների փոփոխությունը կարող է փոխել նույն նյութի ծավալը։",
          "titleHy": "Ինչպե՞ս կապել դիտումը մասնիկային մոդելի հետ",
          "metadata": {
            "sprint": "15B.13",
            "learnerVisible": false,
            "referenceMetadata": {
              "textbookSha256": "d8404d572f145d4afe924d0b8af900b3d9ed085a37893594667ab07a2ec12904",
              "textbookLocator": "Ֆիզիկա 7 (2023), Գլուխ II, §7, տպագիր էջեր 24-26, նկարներ 22-24",
              "programmeOutcomeLocator": "7-րդ դասարան / Թեմա 2 / Վերջնարդյունքներ / Պարտադիր 1(1)"
            },
            "authoringProfileVersion": "haiedu-evidence-blueprint-v1"
          },
          "strategyHy": "Սկզբում նկարագրիր՝ ինչ է չափվել կամ դիտվել՝ ծավալ, մխոցի դիրք, լարի երկարություն։ Ապա բացատրությունը կառուցիր մասնիկների միջև միջին հեռավորությունների փոփոխությամբ։ Փակ համակարգում, երբ նյութ չի ավելացվում կամ կորչում և քիմիական փոփոխություն չկա, մասնիկների քանակն ու ինքնությունը պահպանվում են։ Ջերմային ընդարձակման պարզ մոդելում առանձին մասնիկների չափերի մեծացում չենք ենթադրում։ Մակրոսկոպական նկարն ինքնին առանձին մասնիկի չափում չէ։",
          "itemTemplateId": "b207b366-8ad0-4966-a162-a2068504a989",
          "workedExampleHy": "Փակ պլաստիկ շշի օդը սեղմում են՝ առանց օդի արտահոսքի։ Պարզ մասնիկային մոդելում օդի մասնիկների քանակն ու ինքնությունը պահպանվում են, իսկ նրանց միջև միջին հեռավորությունները փոքրանում են։ Սա ծավալի փոփոխության բացատրություն է, ոչ թե մասնիկների անհետացման դիտում։",
